# General Configuration
# SKU_MASTER_PATH="synthetic dataset/sku_master.csv"
# SALES_HISTORY_PATH="synthetic dataset/seasonal_sales_history.csv"

# Agent Parameters (Optional overrides)
# FEE_GST_RATE=0.18
# DEMAND_UNCERTAINTY_FACTOR=1.5

# LangChain / Groq Configuration
ENABLE_LANGCHAIN=True
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1

# Feature Toggles
ENABLE_PROFIT_DOCTOR_LLM=True
ENABLE_INVENTORY_SENTINEL_LLM=True
ENABLE_STRATEGY_SUPERVISOR_LLM=True
ENABLE_SEASONAL_ANALYST_LLM=True
ENABLE_AD_OPTIMIZER_LLM=True

# Seasonal Analyst Config
# SEASONAL_PERIOD=12
# MIN_SEASONAL_HISTORY_DAYS=90

# Ad Gateway Config
ENABLE_AD_GATEWAY=True
# DEFAULT_AD_BUDGET=500.0
# AD_ROAS_TARGET=3.0

# Performance
# BATCH_SIZE=5
# ENABLE_CACHING=True

# Shopify Configuration (Required for Shopify integration)
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_secret
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
